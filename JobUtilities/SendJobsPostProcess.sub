executable = /srv01/technion/yonlin/scripts/Triangular-J1J2/JobUtilities/RunPostProcess.sh
arguments = --results_dir $(case_folder)/ --post_process_type $(post_process_type)
root_dir = /storage/ph_keselman/yonlin/TriangularJ1J2
case_folder = $(root_dir)/$(results_dir)
log_name = postprocess_$(post_process_type)

log = $(case_folder)/$(log_name).log
output = $(case_folder)/$(log_name).out
