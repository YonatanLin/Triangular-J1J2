executable = /srv01/technion/yonlin/scripts/Triangular-J1J2/JobUtilities/RunKagomeGutzwiller.sh
arguments = --Lx $(Lx) --Ly $(Ly) --chi $(chi) --flux $(flux) --bc_MPS $(bc_MPS) --gs_manifold_index $(gs_manifold_index) --norm_magz $(norm_magz) --monopole_Q $(monopole_Q) --svd_min $(svd_min) --jastrow_nn_zz $(jastrow_nn_zz) --jastrow_chi_max $(jastrow_chi_max) --jastrow_nn_xy $(jastrow_nn_xy) --jastrow_trotter_res $(jastrow_trotter_res) --virtual_parity $(virtual_parity)
root_dir = /storage/ph_keselman/yonlin/TriangularJ1J2
case_folder = $(root_dir)/$(case_folder_name)
log_name = run

log = $(case_folder)/$(log_name).log
output = $(case_folder)/$(log_name).out
error = $(case_folder)/$(log_name).err

request_cpus = 10
RequestMemory = 369663.99999999994

# 3 Kagome sites per unit cell
chi_factor = real(7E-08) * real($(chi) * $(chi))
memory = (real(3 * $(Lx) * $(Ly) * $(chi_factor)) + 1) * 1024
Initialdir = $(case_folder)
universe = vanilla
input_file = $(root_dir)/kagome_gutz_condor_cases.txt

queue Lx, Ly, chi, flux, bc_MPS, gs_manifold_index, norm_magz, monopole_Q, svd_min, jastrow_nn_zz, jastrow_chi_max, jastrow_nn_xy, jastrow_trotter_res, virtual_parity, case_folder_name from $(input_file)
